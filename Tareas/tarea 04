
library(tidyverse)
library(nycflights13)

force(flights)
glimpse(flights)

# Organizar y conocer
flights |> 
  filter(month == 1 & day == 1)

flights |>
  arrange(year, month, day, dep_time)

flights |>
  distinct(dest)

# 

flights |> 
  mutate(
    gain = dep_delay - arr_delay,
    speed = distance / air_time * 60
  )

# Ordenando, seleccionando y creando columnas
flights |> 
  mutate(
    gain = dep_delay - arr_delay,
    speed = distance / air_time * 60,
    .before = 1
  ) |>
  select(gain, speed)

flights |>
  select(year, month, day)

flights |>
  select(year:day)

flights |>
  select(where(is.character))

flights |>
  relocate(time_hour, air_time)

# Agrupar y promedios 

flights |>
  group_by(month) |>
  summarize(
    avg_delay = mean(dep_delay, na.rm = TRUE),
    n = n()
  )

flights |>
  filter(is.na(dep_delay))

flights |>
  group_by(origin, month) |>
  summarize(
    avg_delay = mean(dep_delay, na.rm = TRUE)
  )

daily <- flights |> group_by(year, month, day)
daily |>
  ungroup()

flights |>
  filter(dest == "IAH") |>
  group_by(year, month, day) |>
  summarize(
    arr_delay = mean(arr_delay, na.rm = TRUE)
  )

#
flights |> filter(arr_delay >= 120)

flights |> filter(dest %in% c("IAH", "HOU"))

flights |> filter(carrier %in% c("UA", "AA", "DL"))

flights |> filter(month %in% c(7, 8, 9))

flights |> filter(arr_delay > 120 & dep_delay <= 0)

 
flights |> filter(dep_delay >= 60 & (dep_delay - arr_delay) > 30)

 
flights |> arrange(desc(dep_delay))
flights |> arrange(dep_time)

flights |> 
  mutate(speed = distance / air_time * 60) |>
  arrange(desc(speed))


flights |> 
  distinct(month, day) |>
  nrow()


flights |> arrange(desc(distance))   
flights |> arrange(distance)         


flights |> select(dep_time, dep_delay, arr_time, arr_delay)
flights |> select(4, 6, 7, 9)

flights |> select(starts_with("dep_"), starts_with("arr_"))
flights |> select(contains("dep_"), contains("arr_"))
flights |> select(matches("^(dep|arr)_(time|delay)$"))
cols <- c("dep_time", "dep_delay", "arr_time", "arr_delay")
flights |> select(any_of(cols))

flights |> select(dep_time, dep_time)


vars <- c("year", "month", "day", "dep_delay", "arr_delay")
flights |> select(any_of(vars))

flights |> select(contains("TIME"))
flights |> select(contains("TIME", ignore.case = FALSE))

flights |> 
  rename(air_time_min = air_time) |> 
  relocate(air_time_min)

flights |> 
  select(tailnum, carrier) |> 
  arrange(carrier)



flights |> 
  group_by(carrier) |> 
  summarize(
    avg_arr_delay = mean(arr_delay, na.rm = TRUE),
    n = n()
  ) |> 
  arrange(desc(avg_arr_delay))


flights |> 
  group_by(dest) |> 
  slice_max(dep_delay, n = 1) |> 
  relocate(dest, dep_delay)


flights |> 
  group_by(hour) |> 
  summarize(dep_delay = mean(dep_delay, na.rm = TRUE)) |> 
  ggplot(aes(x = hour, y = dep_delay)) +
  geom_line() +
  geom_point() +
  labs(
    title = "Atraso promedio de salida según la hora del día",
    x = "Hora del día",
    y = "Atraso promedio (minutos)"
  )

flights |> count(carrier, sort = TRUE)


flights |> 
  group_by(carrier, dest) |> 
  summarize(n = n(), .groups = "drop")


df <- tibble(
  x = 1:5,
  y = c("a", "b", "a", "a", "b"),
  z = c("K", "K", "L", "L", "K")
)

df |> group_by(y)

df |> arrange(y)

df |> 
  group_by(y) |> 
  summarize(mean_x = mean(x))

df |> 
  group_by(y, z) |> 
  summarize(mean_x = mean(x))

df |> 
  group_by(y, z) |> 
  summarize(mean_x = mean(x), .groups = "drop")

df |> group_by(y, z) |> summarize(mean_x = mean(x))
df |> group_by(y, z) |> mutate(mean_x = mean(x))
